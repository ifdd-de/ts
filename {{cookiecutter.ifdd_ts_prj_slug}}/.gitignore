# Local configuration, created from dotenv.dist
.env

# Created by the post-generation hook, never committed
secrets/*
!secrets/.gitkeep

{% if cookiecutter.ifdd_ts_vm_data_dir.startswith("./") -%}
# Data of VictoriaMetrics (IFDD_TS_VM_DATA_DIR)
/{{ cookiecutter.ifdd_ts_vm_data_dir[2:].rstrip("/") }}/

{% endif -%}
# CA certificates of this installation (certs/README.md)
certs/*
!certs/README.md

# Fetched by adm_01_plugins.sh
grafana/plugins/*
!grafana/plugins/.gitkeep
grafana/plugins-cache/

.idea/
__pycache__/
.pytest_cache/

# Local builds of the documentation (docs/en, docs/de)
docs/_build/
